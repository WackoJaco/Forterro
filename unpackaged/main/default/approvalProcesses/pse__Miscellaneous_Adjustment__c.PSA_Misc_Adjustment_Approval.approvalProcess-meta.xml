<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>pse__Description__c</field>
        <field>pse__Amount__c</field>
        <field>Reason__c</field>
        <field>pse__Project__c</field>
        <field>pse__Effective_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>pse__Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Submitted to Region Owner</label>
        <name>Submitted_to_Region_Owner</name>
    </approvalStep>
    <description>Submits Misc Adjustment Approval to the Region Head.</description>
    <emailTemplate>FFX_PSA_Email_Templates/PSA_Misc_Adjustment_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>pse__Miscellaneous_Adjustment__c.pse__Approver__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Miscellaneous_Adjustment__c.pse__Status__c</field>
            <operation>notEqual</operation>
            <value>Submitted,Approved</value>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Miscellaneous_Adjustment__c.pse__Description__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Misc_Adjustment_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PSA_Misc_Adjustment_Request_Approved</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Misc_Adjustment_Set_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PSA_Misc_Adjustment_Request_Rejected</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Misc_Adjustment_Status_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>PSA Misc Adjustment Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Misc_Adjustment_Set_Status_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
