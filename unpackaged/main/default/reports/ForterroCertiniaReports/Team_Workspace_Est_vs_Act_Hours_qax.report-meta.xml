<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(
   Forterro_PSA_EVA__c.CPS_Actual_Hours__c:SUM &lt;= 0 &amp;&amp; Forterro_PSA_EVA__c.CPS_Estimated_Hours__c:SUM &gt; 0,
   -1,

   IF(
      Forterro_PSA_EVA__c.CPS_Estimated_Hours__c:SUM &lt;= 0 &amp;&amp; Forterro_PSA_EVA__c.CPS_Actual_Hours__c:SUM &gt; 0,
