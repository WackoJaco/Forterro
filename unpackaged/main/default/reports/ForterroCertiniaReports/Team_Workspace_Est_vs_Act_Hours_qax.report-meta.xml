      IF(Forterro_PSA_EVA__c.CPS_Actual_Hours__c:SUM = 0 &amp;&amp; Forterro_PSA_EVA__c.CPS_Estimated_Hours__c:SUM = 0,
         0,
         ((Forterro_PSA_EVA__c.CPS_Actual_Hours__c:SUM - Forterro_PSA_EVA__c.CPS_Estimated_Hours__c:SUM)/ Forterro_PSA_EVA__c.CPS_Estimated_Hours__c:SUM)
      )
   )
)</calculatedFormula>
