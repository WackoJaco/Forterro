sce(cell(s_start_date_helper.result, 0, \"FormattedDate\"), \"Unknown\").asObject() }} to {{ coalesce(cell(s_end_date_helper.result, 0, \"FormattedDate\"), \"Unknown\").asObject() }}, Quarterly, Corporate Currency ({{ coalesce(cell(s_corporate_currency_helper.result, 0, \"CorporateCurrency\"), \"Unknown\").asObject() }}), Region ({{ coalesce(join(column(s_region_helper.result, [\"region\"]), \", \"), \"All\").asObject() }}), Practice ({{ coalesce(join(column(s_practice_helper.result, [\"practice\"]), \", \"), \"All\").asObject() }}), Group ({{ coalesce(join(column(s_group_helper.result, [\"group\"]), \", \"), \"All\").asObject() }}), Project ({{ coalesce(join(column(s_project_picker.selection, [\"ProjectName\"]), \", \"), \"All\").asObject() }}), Account ({{ coalesce(join(column(s_account_picker.selection, [\"AccountName\"]), \", \"), \"All\").asObject() }}), Opportunity ({{ coalesce(join(column(s_opportunity_picker.selection, [\"OpportunityName\"]), \", \"), \"All\").asObject() }}), {{ column(ss_adjustments_picker.selection, [\"Display\"]).asObject() }}{{ coalesce(cell(s_version_grouping_primary_helper.result, 0, \"GlobalVersionGrouping\"), cell(s_version_grouping_primary_helper.result, 0, \"ComparisonVersionGrouping\")).asObject() }}\" as Text;\ngood = limit good 1;\nresult = union bad, versionMismatch, good;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false},"s_project_manager_picker":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"groups\":[\"ProjectManagerName\"],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"exclude","steps":["s_comparison_forecast_name_picker","s_global_forecast_name_picker","s_variance_poma","s_variance_rpgpm"]}