lper.selection, 0, \"startDate\"), 0).asObject() }} && 'TimePeriodEndDate_sec_epoch' <= {{ coalesce(cell(s_line_comparison_time_helper.selection, 0, \"endDate\"), 9999999999999).asObject() }};\nglobal = filter q by 'ForecastName' == \"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \"RecordType\"), cell(s_global_forecast_name_picker.selection, 0, \"ForecastName\")).asObject() }}\";\ncomparison = filter q by 'ForecastName' == \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asObject() }}\";\nresult = group global by {{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }} full, comparison by {{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }};\nresult = foreach result generate coalesce(global.{{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }}, comparison.{{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }}) as {{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }},sum(global.{{ cell(s_global_adj_ebw_helper.result, 0, \"Total\").asString() }}) as 'ValueGlobalForecast', sum(comparison.{{ cell(s_comparison_adj_ebw_helper.result, 0, \"Total\").asString() }}) as 'ValueComparisonForecast';\nresult = foreach result generate {{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }},coalesce(ValueGlobalForecast, 0) - coalesce(ValueComparisonForecast, 0) as 'Variance',case\n when coalesce(ValueGlobalForecast, 0) == coalesce(ValueComparisonForecast, 0) then 0\n else ((coalesce(ValueGlobalForecast, 0) - coalesce(ValueComparisonForecast, 0)) / abs(coalesce(ValueGlobalForecast, 0) - coalesce(ValueComparisonForecast, 0))) * abs(coalesce((coalesce(ValueGlobalForecast, 0) - coalesce(ValueComparisonForecast, 0)) / coalesce(ValueComparisonForecast, ValueGlobalForecast), 1))\n end as 'Percent Variance',{{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }} as 'Grouping';\nresult = filter result by Variance != 0;\nresult = filter result by Grouping not in [\"N/A\", \"-\"];\nresult = order result by Variance desc;\nresult = limit result 300000;","receiveFacetSource":{"mode":"include","steps":["s_monthly_revenue_trend","s_quarterly_revenue_trend","s_variance_poma"]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"s_group_items":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"groups\":[\"{{ cell(ss_group_level_picker.selection, 0, \\\"value\\\").asString() }}\"],\"filters\":[[\"{{ cell(ss_group_level_picker.selection, 0, \\\"value\\\").asString() }}\",[\"-\",\"N/A\"],\"not in\"],[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"exclude","steps":["s_comparison_forecast_name_picker","s_global_forecast_name_picker","s_monthly_revenue_trend","s_practice_items","s_quarterly_revenue_trend","s_region_items","s_variance_poma","s_variance_rpgpm"]},"selectMode":"multi","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"s_region_items":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"groups\":[\"{{ cell(ss_region_level_picker.selection, 0, \\\"value\\\").asString() }}\"],\"filters\":[[\"{{ cell(ss_region_level_picker.selection, 0, \\\"value\\\").asString() }}\",[\"-\",\"N/A\"],\"not in\"],[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]}","version":-1.0},"receiveF