coalesce(cell(s_start_date_picker.selection, 0, \\\"Epoch\\\"), 0).asObject() }}\",\"{{ coalesce(cell(s_end_date_picker.selection, 0, \\\"Epoch\\\"), 9999999999999).asObject() }}\"]],\">=<=\"],[\"{{ coalesce(cell(ss_region_level_picker.selection, 0, \\\"value\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ column(s_region_helper.result, [\\\"region\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_practice_level_picker.selection, 0, \\\"value\\\"), \\\"PracticeName00\\\").asString() }}\",\"{{ column(s_practice_helper.result, [\\\"practice\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_group_level_picker.selection, 0, \\\"value\\\"), \\\"GroupName00\\\").asString() }}\",\"{{ column(s_group_helper.result, [\\\"group\\\"]).asObject() }}\",\"in\"],[\"AccountName\",\"{{ coalesce(column(s_account_picker.selection, [\\\"AccountName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectName\",\"{{ coalesce(column(s_project_picker.selection, [\\\"ProjectName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectManagerName\",\"{{ coalesce(column(s_project_manager_picker.selection, [\\\"ProjectManagerName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"OpportunityName\",\"{{ coalesce(column(s_opportunity_picker.selection, [\\\"OpportunityName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"{{ cell(ss_variance_poma_picker.selection, 0, \\\"Value\\\").asString() }}\",\"{{ coalesce(column(s_variance_poma.selection, [\\\"Grouping\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"{{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \\\"RPGName\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ coalesce(column(s_variance_rpgpm.selection, [\\\"Grouping\\\"]), \\\"all\\\").asObject() }}\",\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["s_monthly_revenue_trend","s_project_picker_embedded","s_quarterly_revenue_trend"]},"selectMode":"none","type":"aggregateflex","useGlobal":false,"visualizationParameters":{}},"ss_variance_poma_picker":{"broadcastFacet":true,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"selectMode":"singlerequired","start":"{\"Display\":[\"Project\"]}","type":"staticflex","values":["{\"Display\":\"Project\",\"Value\":\"ProjectName\"}","{\"Display\":\"Opportunity\",\"Value\":\"OpportunityName\"}","{\"Display\":\"Milestone\",\"Value\":\"MilestoneName\"}","{\"Display\":\"Account\",\"Value\":\"AccountName\"}"]},"s_global_adj_ebw_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = group q by all;\nbest = filter q by 'IncludeBestCase' == \"true\";\nbestadjincl = foreach best generate \"Adjustments Included\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"sum(ValueActualBestCase)\" as 'Actual', \"sum(ValueScheduledRevenueBestCase)\" as 'Scheduled', \"sum(ValueAdjustmentBestCase) + sum(ValueUnscheduledRevenueBestCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentBestCase) + sum(ValueProjectUnscheduledBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentBestCase) + sum(ValueOpportunityUnscheduledBestCase)\" as 'UnscheduledOpportunity', \"ValueForecastBestCase\" as 'Forecast', \"ValueTotalBestCase\" as 'Total';\nbestadjexcl = foreach best generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"sum(ValueActualBestCase)\" as 'Actual', \"sum(ValueScheduledRevenueBestCase)\" as 'Scheduled', \"sum(ValueUnscheduledRevenueBestCase)\" as 'Unscheduled', \"sum(ValueProjectUnscheduledBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduledBestCase)\" as 'UnscheduledOpportunity', \"ValueForecastBestCaseExclAdjustments\" as 'Forecast', \"ValueTotalBestCaseExclAdjustments\" as 'Total';\nbestadjonly = foreach best generate \"Adjustments Only\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustmentBestCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentBestCase)\" as 'UnscheduledOpportunity', \"ValueAdjustmentBestCase\" as 'Forecast', \"ValueAdjustmentBestCase\" as 'Total';\nworst = filter q by 'IncludeWorstCase' == \"true\";\nworstadjincl = foreach worst generate \"Adjustments Included\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"sum(ValueActualWorstCase)\" as 'Actual', \"sum(ValueScheduledRevenueWorstCase)\" as 'Scheduled', \"sum(ValueAdjustmentWorstCase) + sum(ValueUnscheduledRevenueWorstCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentWorstCase) + sum(ValueProjectUnscheduledWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentWorstCase) + sum(ValueOpportunityUnscheduledWorstCase)\" as 'UnscheduledOpportunity', \"ValueForecastWorstCase\" as 'Forecast', \"ValueTotalWorstCase\" as 'Total';\nworstadjexcl = foreach worst generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"sum(ValueActualWorstCase)\" as 'Actual', \"sum(ValueScheduledRevenueWorstCase)\" as 'Scheduled', \"sum(ValueUnscheduledRevenueWorstCase)\" as 'Unscheduled', \"sum(ValueProjectUnscheduledWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduledWorstCase)\" as 'UnscheduledOpportunity', \"ValueForecastWorstCaseExclAdjustments\" as 'Forecast', \"ValueTotalWorstCaseExclAdjustments\" as 'Total';\nworstadjonly = foreach worst generate \"Adjustments Only\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustmentWorstCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentWorstCase)\" as 'UnscheduledOpportunity', \"ValueAdjustmentWorstCase\" as 'Forecast', \"ValueAdjustmentWorstCase\" as 'Total';\nexpectedadjincl = foreach q generate \"Adjustments Included\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"sum('ValueActual')\" as 'Actual', \"sum('ValueScheduledRevenue')\" as 'Scheduled', \"sum(ValueAdjustment) + sum(ValueUnscheduledRevenue)\" as 'Unscheduled', \"sum(ValueProjectAdjustment) + sum(ValueProjectUnscheduled)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustment) + sum(ValueOpportunityUnscheduled)\" as 'UnscheduledOpportunity', \"ValueForecast\" as 'Forecast', \"ValueTotal\" as 'Total';\nexpectedadjexcl = foreach q generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"sum(ValueActual)\" as 'Actual', \"sum(ValueScheduledRevenue)\" as 'Scheduled', \"sum(ValueUnscheduledRevenue)\" as 'Unscheduled', \"sum(ValueProjectUnscheduled)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduled)\" as 'UnscheduledOpportunity', \"ValueForecastExclAdjustments\" as 'Forecast', \"ValueTotalExclAdjustments\" as 'Total';\nexpectedadjonly = foreach q generate \"Adjustments Only\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustment)\" as 'Unscheduled', \"sum(ValueProjectAdjustment)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustment)\" as 'UnscheduledOpportunity', \"ValueAdjustment\" as 'Forecast', \"ValueAdjustment\" as 'Total';\nresult = union bestadjincl, bestadjexcl, bestadjonly, expectedadjincl, expectedadjexcl, expectedadjonly, worstadjincl, worstadjexcl, worstadjonly;\nresult = foreach result generate 'adjustmentsFilter', 'EBW', 'Actual', 'Scheduled', 'Unscheduled', 'UnscheduledProject', 'UnscheduledOpportunity', 'Forecast', 'Total';\nresult = filter result by 'adjustmentsFilter' == \"{{ cell(ss_adjustments_picker.selection, 0, \"Display\").asString() }}\";\nresult = filter result by 'EBW' == \"{{ cell(s_global_forecast_ebw_picker.selection, 0, \"EBW\").asString() }}\";","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_quarterly_revenue_trend":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"{{ cell(s_global_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\",\"ValueGlobalForecastHidden\"],[\"count\",\"*\",\"ValueGlobalForecastShown\"],[\"sum\",\"{{ cell(s_comparison_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\",\"ValueComparisonForecastHidden\"],[\"count\",\"*\",\"ValueComparisonForecastShown\"],[\"count\",\"*\",\"VariancePercent\"]],\"columns\":[{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_global_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]},\"name\":\"ValueGlobalForecastHidden\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"formula\":\"{{ cell(ss_revenue_trend.selection, 0, \\\"formulaGlobalForecastQuarterly\\\").asString() }}\"},\"name\":\"ValueGlobalForecastShown\",\"header\":\"Forecast Version\"},{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_comparison_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"filters\":[[\"ForecastName\",[\"{{ cell(s_comparison_forecast_name_picker.selection, 0, \\\"ForecastName\\\").asString() }}\"],\"in\"]]},\"name\":\"ValueComparisonForecastHidden\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"formula\":\"{{ cell(ss_revenue_trend.selection, 0, \\\"formulaComparisonForecastQuarterly\\\").asString() }}\"},\"name\":\"ValueComparisonForecastShown\",\"header\":\"Comparison\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"formula\":\"(ValueGlobalForecastHidden - ValueComparisonForecastHidden) / ValueComparisonForecastHidden\"},\"name\":\"VariancePercent\",\"header\":\"Percent Variance\"}],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Quarter\"]],\"filters\":[[\"TimePeriodStartDate\",[[\"{{ coalesce(cell(s_start_date_picker.selection, 0, \\\"Epoch\\\"), 0).asObject() }}\",\"{{ coalesce(cell(s_end_date_picker.selection, 0, \\\"Epoch\\\"), 9999999999999).asObject() }}\"]],\">=<=\"],[\"{{ coalesce(cell(ss_region_level_picker.selection, 0, \\\"value\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ column(s_region_helper.result, [\\\"region\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_practice_level_picker.selection, 0, \\\"value\\\"), \\\"PracticeName00\\\").asString() }}\",\"{{ column(s_practice_helper.result, [\\\"practice\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_group_level_picker.selection, 0, \\\"value\\\"), \\\"GroupName00\\\").asString() }}\",\"{{ column(s_group_helper.result, [\\\"group\\\"]).asObject() }}\",\"in\"],[\"AccountName\",\"{{ coalesce(column(s_account_picker.selection, [\\\"AccountName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectName\",\"{{ coalesce(column(s_project_picker.selection, [\\\"ProjectName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectManagerName\",\"{{ coalesce(column(s_project_manager_picker.selection, [\\\"ProjectManagerName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"OpportunityName\",\"{{ coalesce(column(s_opportunity_picker.selection, [\\\"OpportunityName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"{{ cell(ss_variance_poma_picker.selection, 0, \\\"Value\\\").asString() }}\",\"{{ coalesce(column(s_variance_poma.selection, [\\\"Grouping\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"{{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \\\"RPGName\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ coalesce(column(s_variance_rpgpm.selection, [\\\"Grouping\\\"]), \\\"all\\\").asObject() }}\",\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["s_monthly_revenue_trend","s_project_picker_embedded"]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"ss_group_level_picker":{"broadcastFacet":false,"columns":{"display":{"type":"string"},"value":{"type":"string"}},"selectMode":"singlerequired","start":"{\"display\":[\"Level 00\"]}","type":"staticflex","values":["{\"display\":\"Level 00\",\"value\":\"GroupName00\"}","{\"display\":\"Level 01\",\"value\":\"GroupName01\"}","{\"display\":\"Level 02\",\"value\":\"GroupName02\"}","{\"display\":\"Level 03\",\"value\":\"GroupName03\"}","{\"display\":\"Level 04\",\"value\":\"GroupName04\"}","{\"display\":\"Level 05\",\"value\":\"GroupName05\"}","{\"display\":\"Level 06\",\"value\":\"GroupName06\"}","{\"display\":\"Level 07\",\"value\":\"GroupName07\"}"]},"s_variance_poma":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = filter q by 'TimePeriodStartDate_sec_epoch' >= {{ coalesce(cell(s_start_date_picker.selection, 0, \"Epoch\"), 0).asObject() }} / 1000 && 'TimePeriodStartDate_sec_epoch' <= {{ coalesce(cell(s_end_date_picker.selection, 0, \"Epoch\"), 9999999999999).asObject() }} / 1000;\nq = filter q by {{ coalesce(cell(ss_region_level_picker.selection, 0, \"value\"), \"RegionName00\").asString() }} in {{ coalesce(column(s_region_helper.result, [\"region\"]), \"all\").asString() }};\nq = filter q by {{ coalesce(cell(ss_practice_level_picker.selection, 0, \"value\"), \"PracticeName00\").asString() }} in {{ coalesce(column(s_practice_helper.result, [\"practice\"]), \"all\").asString() }};\nq = filter q by {{ coalesce(cell(ss_group_level_picker.selection, 0, \"value\"), \"GroupName00\").asString() }} in {{ coalesce(column(s_group_helper.result, [\"group\"]), \"all\").asString() }};\nq = filter q by 'AccountName' in {{ coalesce(column(s_account_picker.selection, [\"AccountName\"]), \"all\").asString() }};\nq = filter q by 'ProjectName' in {{ coalesce(column(s_project_picker.selection, [\"ProjectName\"]), \"all\").asString() }};\nq = filter q by 'ProjectManagerName' in {{ coalesce(column(s_project_manager_picker.selection, [\"ProjectManagerName\"]), \"all\").asString() }};\nq = filter q by 'OpportunityName' in {{ coalesce(column(s_opportunity_picker.selection, [\"OpportunityName\"]), \"all\").asString() }};\nq = filter q by 'TimePeriodEndDate_sec_epoch' >= {{ coalesce(cell(s_line_comparison_time_helper.selection, 0, \"startDate\"), 0).asObject() }} && 'TimePeriodEndDate_sec_epoch' <= {{ coalesce(cell(s_line_comparison_time_helper.selection, 0, \"endDate\"), 9999999999999).asObject() }};\nglobal = filter q by 'ForecastName' == \"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \"RecordType\"), cell(s_global_forecast_name_picker.selection, 0, \"ForecastName\")).asObject() }}\";\ncomparison = filter q by 'ForecastName' == \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asObject() }}\";\nresult = group global by {{ cell(ss_variance_poma_picker.selection, 0, \"Value\").asString() }} full, comparison by {{ cell(ss_variance_poma_picker.selection, 0, \"Value\").asString() }};\nresult = foreach result generate coalesce(global.{{ cell(ss_variance_poma_picker.selection, 0, \"Value\").asString() }}, comparison.{{ cell(ss_variance_poma_picker.selection, 0, \"Value\").asString() }}) as {{ coalesce(cell(ss_variance_poma_picker.selection, 0, \"Value\"), \"ProjectName\").asString() }}, coalesce(sum(global.{{ cell(s_global_adj_ebw_helper.result, 0, \"Total\").asString() }}), 0) as 'GlobalTotal', coalesce(sum(comparison.{{ cell(s_comparison_adj_ebw_helper.result, 0, \"Total\").asString() }}), 0) as 'ComparisonTotal';\nresult = foreach result generate {{ coalesce(cell(ss_variance_poma_picker.selection, 0, \"Value\"), \"ProjectName\").asString() }}, abs(GlobalTotal - ComparisonTotal) as 'AbsVariance',GlobalTotal - ComparisonTotal as 'Variance',coalesce((GlobalTotal - ComparisonTotal) / ComparisonTotal, 1) as 'Percent Variance', {{ coalesce(cell(ss_variance_poma_picker.selection, 0, \"Value\"), \"ProjectName\").asString() }} as 'Grouping';\nresult = filter result by Variance != 0;\nresult = filter result by Grouping != \"N/A\";\nresult = order result by ({{ cell(ss_variance_poma_sub_picker.selection, 0, \"Order\").asString() }});\nresult = limit result {{ cell(ss_variance_poma_sub_picker.selection, 0, \"Value\").asString() }};","receiveFacetSource":{"mode":"include","steps":["s_monthly_revenue_trend","s_quarterly_revenue_trend","s_variance_rpgpm"]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"s_variance_detail":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = filter q by 'TimePeriodStartDate_sec_epoch' >= {{ coalesce(cell(s_start_date_picker.selection, 0, \"Epoch\"), 0).asObject() }} / 1000 && 'TimePeriodStartDate_sec_epoch' <= {{ coalesce(cell(s_end_date_picker.selection, 0, \"Epoch\"), 9999999999999).asObject() }} / 1000;\nq = filter q by {{ coalesce(cell(ss_region_level_picker.selection, 0, \"value\"), \"RegionName00\").asString() }} in {{ coalesce(column(s_region_helper.result, [\"region\"]), \"all\").asString() }};\nq = filter q by {{ coalesce(cell(ss_practice_level_picker.selection, 0, \"value\"), \"PracticeName00\").asString() }} in {{ coalesce(column(s_practice_helper.result, [\"practice\"]), \"all\").asString() }};\nq = filter q by {{ coalesce(cell(ss_group_level_picker.selection, 0, \"value\"), \"GroupName00\").asString() }} in {{ coalesce(column(s_group_helper.result, [\"group\"]), \"all\").asString() }};\nq = filter q by 'AccountName' in {{ coalesce(column(s_account_picker.selection, [\"AccountName\"]), \"all\").asString() }};\nq = filter q by 'ProjectName' in {{ coalesce(column(s_project_picker.selection, [\"ProjectName\"]), \"all\").asString() }};\nq = filter q by 'ProjectManagerName' in {{ coalesce(column(s_project_manager_picker.selection, [\"ProjectManagerName\"]), \"all\").asString() }};\nq = filter q by 'OpportunityName' in {{ coalesce(column(s_opportunity_picker.selection, [\"OpportunityName\"]), \"all\").asString() }};\nq = filter q by {{ cell(ss_variance_poma_picker.selection, 0, \"Value\").asString() }} in {{ coalesce(column(s_variance_poma.selection, [\"Grouping\"]), \"all\").asString() }};\nq = filter q by {{ coalesce(cell(s_variance_rpgpm_level_picker.selection, 0, \"RPGName\"), \"RegionName00\").asString() }} in {{ coalesce(column(s_variance_rpgpm.selection, [\"Grouping\"]), \"all\").asString() }};\nglobal = filter q by 'ForecastName' == \"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \"RecordType\"), cell(s_global_forecast_name_picker.selection, 0, \"ForecastName\")).asObject() }}\";\ncomparison = filter q by 'ForecastName' == \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asObject() }}\";\nresult = group global by ('Name', 'Type', 'MilestoneName', 'AccountName') full, comparison by ('Name', 'Type', 'MilestoneName', 'AccountName');\nresult = foreach result generate coalesce(global.'Name', comparison.'Name') as 'Name', coalesce(global.'Type', comparison.'Type') as 'Type', coalesce(global.'MilestoneName', comparison.'MilestoneName') as 'MilestoneName', coalesce(global.'AccountName', comparison.'AccountName') as 'AccountName', sum(global.'{{ cell(s_global_adj_ebw_helper.result, 0, \"Total\").asString() }}') as 'Forecast Version', sum(comparison.'{{ cell(s_comparison_adj_ebw_helper.result, 0, \"Total\").asString() }}') as 'Comparison';\nresult = foreach result generate 'Name', 'Type', 'MilestoneName', 'AccountName', 'Forecast Version', 'Comparison', (coalesce('Forecast Version', 0) - coalesce('Comparison', 0)) as 'Revenue Variance', case when (coalesce('Forecast Version', 0) - coalesce('Comparison', 0)) == 0 then 0 else ((coalesce('Forecast Version', 0) - coalesce('Comparison', 0)) / abs((coalesce('Forecast Version', 0) - coalesce('Comparison', 0)))) * abs(coalesce((coalesce('Forecast Version', 0) - coalesce('Comparison', 0)) / coalesce('Comparison', 'Forecast Version'), 1)) end as '% Variance';\nresult = filter result by {{ cell(ss_zero_value_records_picker.selection, 0, \"saql\").asString() }};\nresult = order result by ('Name' asc, 'Type' asc, 'MilestoneName' asc, 'AccountName' asc);\nresult = limit result 300000;","receiveFacetSource":{"mode":"include","steps":["s_monthly_revenue_trend","s_quarterly_revenue_trend"]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"ProjCF_Project_Sub_T_1":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"label":"ProjCF_Project_Sub_T_1","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"ProjCF_Project_Sub_Types\"]}","version":-1.0},"receiveFacetSource":{"mode":"exclude","steps":["s_comparison_forecast_name_picker","s_variance_poma","s_variance_rpgpm","s_global_forecast_name_picker"]},"selectMode":"multi","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["ProjCF_Project_Sub_Types"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"s_monthly_line_comparison":{"broadcastFacet":false,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"{{ cell(s_global_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\",\"ValueGlobalForecast\"],[\"sum\",\"{{ cell(s_comparison_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\",\"ValueComparisonForecast\"],[\"count\",\"*\",\"Variance\"]],\"columns\":[{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_global_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Month\"]],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]},\"name\":\"ValueGlobalForecast\",\"header\":\"Forecast Version\"},{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_comparison_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Month\"]],\"filters\":[[\"ForecastName\",[\"{{ cell(s_comparison_forecast_name_picker.selection, 0, \\\"ForecastName\\\").asString() }}\"],\"in\"]]},\"name\":\"ValueComparisonForecast\",\"header\":\"Comparison\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"formula\":\"coalesce('ValueGlobalForecast', 0) - coalesce('ValueComparisonForecast', 0)\"},\"name\":\"Variance\",\"header\":\"Variance\"}],\"groups\":[[\"TimePeriodEndDate_Year\",\"TimePeriodEndDate_Month\"]],\"filters\":[[\"TimePeriodStartDate\",[[\"{{ coalesce(cell(s_start_date_picker.selection, 0, \\\"Epoch\\\"), 0).asObject() }}\",\"{{ coalesce(cell(s_end_date_picker.selection, 0, \\\"Epoch\\\"), 9999999999999).asObject() }}\"]],\">=<=\"],[\"{{ coalesce(cell(ss_region_level_picker.selection, 0, \\\"value\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ column(s_region_helper.result, [\\\"region\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_practice_level_picker.selection, 0, \\\"value\\\"), \\\"PracticeName00\\\").asString() }}\",\"{{ column(s_practice_helper.result, [\\\"practice\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_group_level_picker.selection, 0, \\\"value\\\"), \\\"GroupName00\\\").asString() }}\",\"{{ column(s_group_helper.result, [\\\"group\\\"]).asObject() }}\",\"in\"],[\"AccountName\",\"{{ coalesce(column(s_account_picker.selection, [\\\"AccountName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectName\",\"{{ coalesce(column(s_project_picker.selection, [\\\"ProjectName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectManagerName\",\"{{ coalesce(column(s_project_manager_picker.selection, [\\\"ProjectManagerName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"OpportunityName\",\"{{ coalesce(column(s_opportunity_picker.selection, [\\\"OpportunityName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"TimePeriodEndDate_sec_epoch\",[[\"{{ cell(s_line_comparison_time_helper.result, 0, \\\"startDate\\\").asObject() }}\",\"{{ cell(s_line_comparison_time_helper.result, 0, \\\"endDate\\\").asObject() }}\"]],\">=<=\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["s_project_picker_embedded"]},"selectMode":"none","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"s_monthly_subtitle_embedded_display_helper":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nbad = foreach q generate \"rgb(180, 67, 58)\" as BackgroundColor, \"rgb(255, 255, 255)\" as TextColor, \"No data available to display. Adjust your Expected, Worst Case and Best Case scenario filters to continue.\" as Text;\nbad = limit bad 1;\nversionMismatch = foreach q generate \"rgb(180, 67, 58)\" as BackgroundColor, \"rgb(255, 255, 255)\" as TextColor, \"To compare forecast versions, ensure their groupings match. Review your forecast selections and try again.\" as Text;\nversionMismatch = limit versionMismatch 1;\ngood = foreach q generate \"rgba(0, 0, 0, 0)\" as BackgroundColor, \"rgb(9, 26, 62)\" as TextColor, \"{{ coalesce(cell(s_start_date_helper.result, 0, \"FormattedDate\"), \"Unknown\").asObject() }} to {{ coalesce(cell(s_end_date_helper.result, 0, \"FormattedDate\"), \"Unknown\").asObject() }}, Monthly, Corporate Currency ({{ coalesce(cell(s_corporate_currency_helper.result, 0, \"CorporateCurrency\"), \"Unknown\").asObject() }}), Region ({{ coalesce(join(column(s_region_helper.result, [\"region\"]), \", \"), \"All\").asObject() }}), Practice ({{ coalesce(join(column(s_practice_helper.result, [\"practice\"]), \", \"), \"All\").asObject() }}), Group ({{ coalesce(join(column(s_group_helper.result, [\"group\"]), \", \"), \"All\").asObject() }}), Project ({{ coalesce(join(column(s_project_picker_embedded.selection, [\"ProjectName\"]), \", \"), \"All\").asObject() }}), Account ({{ coalesce(join(column(s_account_picker.selection, [\"AccountName\"]), \", \"), \"All\").asObject() }}), Opportunity ({{ coalesce(join(column(s_opportunity_picker.selection, [\"OpportunityName\"]), \", \"), \"All\").asObject() }}), {{ column(ss_adjustments_picker.selection, [\"Display\"]).asObject() }}{{ coalesce(cell(s_version_grouping_primary_helper.result, 0, \"GlobalVersionGrouping\"), cell(s_version_grouping_primary_helper.result, 0, \"ComparisonVersionGrouping\")).asObject() }}\" as Text;\ngood = limit good 1;\nresult = union bad, versionMismatch, good;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false},"s_practice_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = foreach q generate {{ coalesce(cell(ss_practice_level_picker.selection, 0, \"value\"), \"practiceName00\").asObject() }} as 'practice';\nq = filter q by 'practice' in [\"{{ join(column(s_practice_items.selection, column(ss_practice_level_picker.selection, [\"value\"])), '\", \"').asObject() }}\"];\nq = group q by 'practice';\nq = foreach q generate 'practice';","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_variance_overview_pills":{"broadcastFacet":false,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"ValueTotal\",\"ValueGlobalForecast\"],[\"sum\",\"ValueTotal\",\"ValueComparisonForecast\"],[\"count\",\"*\",\"Variance\"],[\"count\",\"*\",\"AbsolutePercent\"]],\"columns\":[{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_global_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]},\"name\":\"ValueGlobalForecast\",\"header\":\"ValueGlobalForecast\"},{\"query\":{\"measures\":[[\"sum\",\"{{ cell(s_comparison_adj_ebw_helper.result, 0, \\\"Total\\\").asString() }}\"]],\"filters\":[[\"ForecastName\",[\"{{ cell(s_comparison_forecast_name_picker.selection, 0, \\\"ForecastName\\\").asString() }}\"],\"in\"]]},\"name\":\"ValueComparisonForecast\",\"header\":\"ValueComparisonForecast\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"formula\":\"coalesce('ValueGlobalForecast', 0) - coalesce('ValueComparisonForecast', 0)\"},\"name\":\"Variance\",\"header\":\"Variance\"},{\"query\":{\"measures\":[[\"count\",\"*\"]],\"formula\":\"case when 'Variance' == 0 then 0 else abs(coalesce('Variance' / coalesce('ValueComparisonForecast', 'ValueGlobalForecast'), 1)) end\"},\"name\":\"AbsolutePercent\",\"header\":\"AbsolutePercent\"}],\"filters\":[[\"TimePeriodStartDate\",[[\"{{ coalesce(cell(s_start_date_picker.selection, 0, \\\"Epoch\\\"), 0).asObject() }}\",\"{{ coalesce(cell(s_end_date_picker.selection, 0, \\\"Epoch\\\"), 9999999999999).asObject() }}\"]],\">=<=\"],[\"{{ coalesce(cell(ss_region_level_picker.selection, 0, \\\"value\\\"), \\\"RegionName00\\\").asString() }}\",\"{{ column(s_region_helper.result, [\\\"region\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_practice_level_picker.selection, 0, \\\"value\\\"), \\\"PracticeName00\\\").asString() }}\",\"{{ column(s_practice_helper.result, [\\\"practice\\\"]).asObject() }}\",\"in\"],[\"{{ coalesce(cell(ss_group_level_picker.selection, 0, \\\"value\\\"), \\\"GroupName00\\\").asString() }}\",\"{{ column(s_group_helper.result, [\\\"group\\\"]).asObject() }}\",\"in\"],[\"AccountName\",\"{{ coalesce(column(s_account_picker.selection, [\\\"AccountName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectName\",\"{{ coalesce(column(s_project_picker.selection, [\\\"ProjectName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"ProjectManagerName\",\"{{ coalesce(column(s_project_manager_picker.selection, [\\\"ProjectManagerName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"OpportunityName\",\"{{ coalesce(column(s_opportunity_picker.selection, [\\\"OpportunityName\\\"]), \\\"all\\\").asObject() }}\",\"in\"],[\"TimePeriodEndDate_sec_epoch\",[[\"{{ cell(s_line_comparison_time_helper.result, 0, \\\"startDate\\\").asObject() }}\",\"{{ cell(s_line_comparison_time_helper.result, 0, \\\"endDate\\\").asObject() }}\"]],\">=<=\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["s_project_picker_embedded"]},"selectMode":"none","type":"aggregateflex","useGlobal":false,"visualizationParameters":{}},"s_account_picker":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"groups\":[\"AccountName\"],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"exclude","steps":["s_comparison_forecast_name_picker","s_global_forecast_name_picker","s_variance_poma","s_variance_rpgpm"]},"selectMode":"multi","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"s_line_comparison_time_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = filter q by ForecastName in [\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \"RecordType\"), cell(s_global_forecast_name_picker.selection, 0, \"ForecastName\")).asString() }}\", \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asString() }}\"];\nq = group q by ForecastName;\nq = foreach q generate ForecastName, min(TimePeriodEndDate_sec_epoch) as startDate, max(TimePeriodEndDate_sec_epoch) as endDate;\nq = group q by ForecastName;\nq = foreach q generate max(max(startDate)) over([..] partition by all) as startDate, min(min(endDate)) over([..] partition by all) as endDate;\nq = limit q 1;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_comparison_adj_ebw_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = group q by all;\nbest = filter q by 'IncludeBestCase' == \"true\";\nbestadjincl = foreach best generate \"Adjustments Included\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"sum(ValueActualBestCase)\" as 'Actual', \"sum(ValueScheduledRevenueBestCase)\" as 'Scheduled', \"sum(ValueAdjustmentBestCase) + sum(ValueUnscheduledRevenueBestCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentBestCase) + sum(ValueProjectUnscheduledBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentBestCase) + sum(ValueOpportunityUnscheduledBestCase)\" as 'UnscheduledOpportunity', \"ValueForecastBestCase\" as 'Forecast', \"ValueTotalBestCase\" as 'Total';\nbestadjexcl = foreach best generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"sum(ValueActualBestCase)\" as 'Actual', \"sum(ValueScheduledRevenueBestCase)\" as 'Scheduled', \"sum(ValueUnscheduledRevenueBestCase)\" as 'Unscheduled', \"sum(ValueProjectUnscheduledBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduledBestCase)\" as 'UnscheduledOpportunity', \"ValueForecastBestCaseExclAdjustments\" as 'Forecast', \"ValueTotalBestCaseExclAdjustments\" as 'Total';\nbestadjonly = foreach best generate \"Adjustments Only\" as 'adjustmentsFilter', \"Best Case\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustmentBestCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentBestCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentBestCase)\" as 'UnscheduledOpportunity', \"ValueAdjustmentBestCase\" as 'Forecast', \"ValueAdjustmentBestCase\" as 'Total';\nworst = filter q by 'IncludeWorstCase' == \"true\";\nworstadjincl = foreach worst generate \"Adjustments Included\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"sum(ValueActualWorstCase)\" as 'Actual', \"sum(ValueScheduledRevenueWorstCase)\" as 'Scheduled', \"sum(ValueAdjustmentWorstCase) + sum(ValueUnscheduledRevenueWorstCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentWorstCase) + sum(ValueProjectUnscheduledWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentWorstCase) + sum(ValueOpportunityUnscheduledWorstCase)\" as 'UnscheduledOpportunity', \"ValueForecastWorstCase\" as 'Forecast', \"ValueTotalWorstCase\" as 'Total';\nworstadjexcl = foreach worst generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"sum(ValueActualWorstCase)\" as 'Actual', \"sum(ValueScheduledRevenueWorstCase)\" as 'Scheduled', \"sum(ValueUnscheduledRevenueWorstCase)\" as 'Unscheduled', \"sum(ValueProjectUnscheduledWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduledWorstCase)\" as 'UnscheduledOpportunity', \"ValueForecastWorstCaseExclAdjustments\" as 'Forecast', \"ValueTotalWorstCaseExclAdjustments\" as 'Total';\nworstadjonly = foreach worst generate \"Adjustments Only\" as 'adjustmentsFilter', \"Worst Case\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustmentWorstCase)\" as 'Unscheduled', \"sum(ValueProjectAdjustmentWorstCase)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustmentWorstCase)\" as 'UnscheduledOpportunity', \"ValueAdjustmentWorstCase\" as 'Forecast', \"ValueAdjustmentWorstCase\" as 'Total';\nexpectedadjincl = foreach q generate \"Adjustments Included\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"sum('ValueActual')\" as 'Actual', \"sum('ValueScheduledRevenue')\" as 'Scheduled', \"sum(ValueAdjustment) + sum(ValueUnscheduledRevenue)\" as 'Unscheduled', \"sum(ValueProjectAdjustment) + sum(ValueProjectUnscheduled)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustment) + sum(ValueOpportunityUnscheduled)\" as 'UnscheduledOpportunity', \"ValueForecast\" as 'Forecast', \"ValueTotal\" as 'Total';\nexpectedadjexcl = foreach q generate \"Adjustments Excluded\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"sum(ValueActual)\" as 'Actual', \"sum(ValueScheduledRevenue)\" as 'Scheduled', \"sum(ValueUnscheduledRevenue)\" as 'Unscheduled', \"sum(ValueProjectUnscheduled)\" as 'UnscheduledProject', \"sum(ValueOpportunityUnscheduled)\" as 'UnscheduledOpportunity', \"ValueForecastExclAdjustments\" as 'Forecast', \"ValueTotalExclAdjustments\" as 'Total';\nexpectedadjonly = foreach q generate \"Adjustments Only\" as 'adjustmentsFilter', \"Expected\" as 'EBW', \"0\" as 'Actual', \"0\" as 'Scheduled', \"sum(ValueAdjustment)\" as 'Unscheduled', \"sum(ValueProjectAdjustment)\" as 'UnscheduledProject', \"sum(ValueOpportunityAdjustment)\" as 'UnscheduledOpportunity', \"ValueAdjustment\" as 'Forecast', \"ValueAdjustment\" as 'Total';\nresult = union bestadjincl, bestadjexcl, bestadjonly, expectedadjincl, expectedadjexcl, expectedadjonly, worstadjincl, worstadjexcl, worstadjonly;\nresult = foreach result generate 'adjustmentsFilter', 'EBW', 'Actual', 'Scheduled', 'Unscheduled', 'UnscheduledProject', 'UnscheduledOpportunity', 'Forecast', 'Total';\nresult = filter result by 'adjustmentsFilter' == \"{{ cell(ss_adjustments_picker.selection, 0, \"Display\").asString() }}\";\nresult = filter result by 'EBW' == \"{{ cell(s_comparison_forecast_ebw_picker.selection, 0, \"EBW\").asString() }}\";","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_variance_rpgpm_level_picker":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\n{{ cell(ss_variance_rpgpm_picker.selection, 0, \"saql\").asString() }}","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","strings":[],"type":"saql","useGlobal":true},"s_end_date_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = filter q by 'TimePeriodName' == \"{{ cell(s_end_date_picker.selection, 0, 'TimePeriodName').asString()}}\";\nq = foreach q generate toString(toDate(min(TimePeriodEndDate_sec_epoch)), \"MMM yyyy\") as 'FormattedDate';\nq = limit q 1;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_comparison_forecast_name_helper":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = group q by 'ForecastName';\nq = filter q by 'ForecastName' == \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asObject() }}\";\nq = foreach q generate (case when 'ForecastName' == \"Live\" then \"Live Forecast\" else 'ForecastName' + \" ({{ cell(s_comparison_forecast_ebw_picker.selection, 0, \"EBW\").asObject() }})\" end) as ForecastName;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"ProjCF_CPS_Billing_T_1":{"broadcastFacet":true,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"measures