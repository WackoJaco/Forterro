ection, [\"Display\"]).asObject() }}{{ coalesce(cell(s_version_grouping_primary_helper.result, 0, \"GlobalVersionGrouping\"), cell(s_version_grouping_primary_helper.result, 0, \"ComparisonVersionGrouping\")).asObject() }}\" as Text;\ngood = limit good 1;\nresult = union bad, versionMismatch, good;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false},"s_ebw_valid":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nglobal = filter q by 'ForecastName' == \"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \"RecordType\"), cell(s_global_forecast_name_picker.selection, 0, \"ForecastName\")).asString() }}\" && {{ cell(s_global_forecast_ebw_picker.selection, 0, \"saqlFilter\").asString() }} \"true\";\ncomparison = filter q by 'ForecastName' == \"{{ cell(s_comparison_forecast_name_picker.selection, 0, \"ForecastName\").asString() }}\" && {{ cell(s_comparison_forecast_ebw_picker.selection, 0, \"saqlFilter\").asString() }} \"true\";\nresult = group global by all full, comparison by all;\nresult = foreach result generate case when sum(global.'ValueUnscheduledRevenue') is not null && sum(comparison.'ValueUnscheduledRevenue') is not null then 1 else 0 end as 'IsValid';\nresult = limit result 1;;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false},"s_line_comparison_percent_pill_text_helper":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = group q by ForecastName;\nq = foreach q generate \n(case when {{ coalesce(cell(s_variance_overview_pills.result, 0, \"Variance\"), 0).asObject() }} > 0 then \"Increase\" when {{ coalesce(cell(s_variance_overview_pills.result, 0, \"Variance\"), 0).asObject() }} < 0 then \"Decrease\" else \"No Change\" end) as PercentText,\n(case when {{ coalesce(cell(s_variance_overview_pills.result, 0, \"Variance\"), 0).asObject() }} > 0 then \"Percentage increase of\" when {{ coalesce(cell(s_variance_overview_pills.result, 0, \"Variance\"), 0).asObject() }} < 0 then \"Percentage decrease of\" else \"No percentage change for\" end) as TooltipText;\nq = limit q 1;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true},"s_start_date_picker":{"broadcastFacet":false,"datasets":[{"name":"RevenueForecast"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\",\"Epoch\"]],\"columns\":[{\"query\":{\"measures\":[[\"count\",\"*\"]],\"groups\":[[\"TimePeriodStartDate_Year\",\"TimePeriodStartDate_Month\",\"TimePeriodStartDate_Day\"],\"TimePeriodName\"],\"formula\":\"first(TimePeriodStartDate_sec_epoch) * 1000\"},\"name\":\"Epoch\"}],\"groups\":[[\"TimePeriodStartDate_Year\",\"TimePeriodStartDate_Month\",\"TimePeriodStartDate_Day\"],\"TimePeriodName\"],\"filters\":[[\"ForecastName\",[\"{{ coalesce(cell(s_global_forecast_embedded_helper.selection, 0, \\\"RecordType\\\"), cell(s_global_forecast_name_picker.selection, 0, \\\"ForecastName\\\")).asString() }}\"],\"in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"exclude","steps":["s_comparison_forecast_name_picker","s_global_forecast_name_picker","s_group_items","s_monthly_revenue_trend","s_practice_items","s_quarterly_revenue_trend","s_region_items","s_variance_poma","s_variance_rpgpm"]},"selectMode":"singlerequired","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"s_quarterly_subtitle_embedded_display":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"RevenueForecast\";\nq = foreach q generate \"{{ cell(s_quarterly_subtitle_embedded_display_helper.result, coalesce(cell(s_subtitle_display_valid_helper.result, 0, \"IsValid\"), 0), \"Text\").asObject() }}\" as Text;\nq = limit q 1","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false},"s_monthly_subtitle_embedded_display":{"broadcastFacet":false,