<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FFX_Complete_Hours__c</fullName>
    <formula>IF(ISBLANK(pse__Estimated_Time_To_Completion__c), (pse__Billable_Hours_In_Financials__c  / pse__Planned_Hours__c), (pse__Billable_Hours_In_Financials__c  / (pse__Estimated_Time_To_Completion__c + pse__Billable_Hours_In_Financials__c)))</formula>
    <label>% Complete</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
