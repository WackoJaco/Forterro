<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Assignment_Scheduled_vs_Actual_Hours</fullName>
    <active>false</active>
    <errorConditionFormula>( pse__Billable_Hours_Submitted__c + pse__Non_Billable_Hours_Submitted__c ) &gt; pse__Scheduled_Hours__c</errorConditionFormula>
    <errorMessage>Hours Submitted can't exceed the amount of hours Scheduled on an Assignment</errorMessage>
</ValidationRule>
