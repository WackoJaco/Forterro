<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Scheduled_Hours_Greater_than_Planned</fullName>
    <active>false</active>
    <errorConditionFormula>AND (
       pse__Scheduled_Hours__c &gt;  Task_Assignment_Hours__c ,
        Not(IsNEW())
     )</errorConditionFormula>
    <errorMessage>Scheduled Hours cannot be greater than Planned Hours.</errorMessage>
</ValidationRule>
