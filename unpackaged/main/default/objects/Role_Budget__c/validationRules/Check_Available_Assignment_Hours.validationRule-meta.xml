<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Available_Assignment_Hours</fullName>
    <active>false</active>
    <errorConditionFormula>AND (IsNew(),
Assigned_Hours__c &gt;  Budget_Incl_Tolerance__c 
)</errorConditionFormula>
    <errorMessage>There are no available hours remaining to assign these hours. Please review the role budget.</errorMessage>
</ValidationRule>
