<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BIll_Rate_Populated_When_Credited</fullName>
    <active>false</active>
    <errorConditionFormula>AND ( Credited_Hours__c ,
       Rate__c &gt; 0
    )</errorConditionFormula>
    <errorMessage>Bill Rate should not be populated if Role Budget is for Credited Hours.</errorMessage>
</ValidationRule>
