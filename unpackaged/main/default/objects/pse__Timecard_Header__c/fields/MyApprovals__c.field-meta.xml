<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MyApprovals__c</fullName>
    <formula>AND(pse__Resource__r.pse__Salesforce_User__c &lt;&gt; $User.Id,
				
OR( pse__Project__r.psaws__Project_Manager_Is_Current_User__c,
    CPS_Project_Override_Approver__r.Id  =  $User.Id))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>MyApprovals</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
