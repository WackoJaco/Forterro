<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Role_Budget_Role_Invalid</fullName>
    <active>false</active>
    <errorConditionFormula>AND ( Not(IsBlank(Role_Budget__c)), 
         TEXT(pse__Resource_Role__c)&lt;&gt; TEXT(Role_Budget__r.Role__c )
     )</errorConditionFormula>
    <errorMessage>The role on the Project Task Assignment and the Role Budget do not match.</errorMessage>
</ValidationRule>
