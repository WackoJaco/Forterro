<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Change_Role_Budget_on_PTA_with_RR</fullName>
    <active>false</active>
    <errorConditionFormula>AND (
      Not(isblank(  pse__Resource_Request__c )),
      isChanged( Role_Budget__c )
      )</errorConditionFormula>
    <errorMessage>Role Budget cannot be changed if linked to a Resouce Request.</errorMessage>
</ValidationRule>
