<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Region_or_Group_must_be_selected</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(pse__Region__c ),
	
	 ISBLANK(pse__Group__c )
					)</errorConditionFormula>
    <errorMessage>A Region or Group must be selected.</errorMessage>
</ValidationRule>
