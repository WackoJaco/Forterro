<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Enter_Role_Budget_on_Summary_Task</fullName>
    <active>false</active>
    <errorConditionFormula>AND (
        Not(IsNull( Role_Budget__c) ),
        pse__Summary__c  = TRUE
    )</errorConditionFormula>
    <errorMessage>A Parent/Summary Task cannot have a Role Budget. Please remove the Role Budget reference.</errorMessage>
</ValidationRule>
