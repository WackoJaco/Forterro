<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Role_Budget_Requires_Assigned_Resources</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
      OR(
          pse__Number_of_Assignments__c &lt;=0,
          IsNUll(pse__Number_of_Assignments__c)
         ),
        
      Not(IsNull(Role_Budget__c ))
   )</errorConditionFormula>
    <errorMessage>You must Assign Resources to this task before entering the Role Budget reference</errorMessage>
</ValidationRule>
