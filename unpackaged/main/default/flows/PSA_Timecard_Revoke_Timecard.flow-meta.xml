    </start>
    <status>Active</status>
    <textTemplates>
        <name>txtBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hello,

The below timecard has been revoked.

Project Name: {!$Record.pse__Project__r.Name}
Project ID: {!$Record.pse__Project__r.pse__Project_ID__c}
Resource: {!formResourceName}

{!$Record.Name}
{!linktoRecord}

Reason: {!$Record.Revoke_Reason__c}

Revoked By: {!$User.Username}
Date/Time: {!$Flow.CurrentDateTime}

Thanks

Certinia Administration Team</text>
    </textTemplates>
    <textTemplates>
        <name>txtSubject</name>
