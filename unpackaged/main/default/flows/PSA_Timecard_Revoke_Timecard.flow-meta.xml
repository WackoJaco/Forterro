    <description>Triggered when a timecard is revoked. Used by Plan D integration to reset the revoke flag and send an email.</description>
    <environments>Default</environments>
    <formulas>
        <name>formResourceName</name>
        <dataType>String</dataType>
        <expression>{!$Record.pse__Resource__r.FirstName}&amp;  &apos; &apos; &amp;{!$Record.pse__Resource__r.LastName}</expression>
    </formulas>
    <formulas>
        <name>linktoRecord</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260)) &amp; {!$Record.Id}</expression>
    </formulas>
    <interviewLabel>PSA - Timecard - Revoke Timecard {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSA - Timecard - Revoke Timecard</label>
