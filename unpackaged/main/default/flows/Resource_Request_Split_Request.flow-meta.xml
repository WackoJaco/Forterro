    <decisions>
        <name>Check_Request_Status</name>
        <label>Check Request Status</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Split_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assigned_Check_Request_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getRequestDetail.pse__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Assigned</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRequestDetail.pse__Assignment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Request_Invalid</targetReference>
            </connector>
            <label>Assigned</label>
        </rules>
    </decisions>
