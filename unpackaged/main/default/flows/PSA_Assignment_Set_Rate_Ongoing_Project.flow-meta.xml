        <name>AssignmentName</name>
        <dataType>String</dataType>
        <expression>LEFT(LEFT({!$Record.pse__Project__r.Name},60)&amp;&quot; - &quot;&amp;{!$Record.pse__Resource__r.FirstName}&amp;&quot; &quot;&amp;{!$Record.pse__Resource__r.LastName},80)</expression>
    </formulas>
