<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Ensures that the region and group on the User matches the Resource for contextualisation reporting.</description>
    <environments>Default</environments>
    <formulas>
        <name>Group_Text</name>
        <dataType>String</dataType>
        <expression>{!$Record.pse__Group__r.Name}</expression>
    </formulas>
    <formulas>
        <name>Region_Text</name>
        <dataType>String</dataType>
        <expression>{!$Record.pse__Region__r.Name}</expression>
    </formulas>
    <interviewLabel>Certinia - Ensure that the region/group matches from Contact to User. {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Certinia - Ensure that the region/group matches from Contact to User.</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_User_Region_Group_to_match_Contact</name>
        <label>Set User Region/Group to match Contact</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pse__Salesforce_User__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PSA_Group__c</field>
            <value>
                <elementReference>Group_Text</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PSA_Region__c</field>
            <value>
                <elementReference>Region_Text</elementReference>
            </value>
        </inputAssignments>
        <object>User</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_User_Region_Group_to_match_Contact</targetReference>
        </connector>
        <filterLogic>(1 or 2) and 3</filterLogic>
        <filters>
            <field>pse__Region__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pse__Group__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pse__Salesforce_User__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
