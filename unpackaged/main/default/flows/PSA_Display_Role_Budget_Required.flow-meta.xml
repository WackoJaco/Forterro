    <decisions>
        <name>Check_if_Not_Progress_or_Not_Ongoing</name>
        <label>Check if Not Progress or Not Ongoing</label>
        <locationX>248</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Check_if_Not_Progress_or_Not_Ongoing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Requested</stringValue>
