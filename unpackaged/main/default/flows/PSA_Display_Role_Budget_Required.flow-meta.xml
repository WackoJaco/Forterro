            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.Project_Sub_Types__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IBS - Ongoing Work</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Role_Budget_Error</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the project requires a role budget.</description>
        <name>Is_Project_Valid</name>
        <label>Is Project Valid?</label>
        <locationX>347</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_Project_Valid</name>
            <conditionLogic>1 OR (2 AND 3) or 4 or 5</conditionLogic>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Time and Materials</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed Price</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Project_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Packaged Solutions</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Time_Credited__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mixed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_there_a_Fixed_Price_Milestone</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>If there is a fix price milestone and the project is mixed billing type then do not apply Role Budget logic.</description>
        <name>Is_there_a_Fixed_Price_Milestone</name>
        <label>Is there a Fixed Price Milestone?</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Check_if_Not_Progress_or_Not_Ongoing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_there_a_Fixed_Price_Milestone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Milestone__r.Milestone_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed Price</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Resource_Request.pse__Project__r.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mixed</stringValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
