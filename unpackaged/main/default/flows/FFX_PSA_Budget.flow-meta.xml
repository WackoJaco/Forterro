            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Project__r.Project_Sub_Types__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IBS - Ongoing Work</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Budget_Approved_Defaults_on_Create</targetReference>
            </connector>
