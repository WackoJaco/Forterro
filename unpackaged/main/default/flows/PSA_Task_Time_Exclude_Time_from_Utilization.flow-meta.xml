<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Excludes timecards from utilization if Type is Education and Exclude from Utilization is True.</description>
    <environments>Default</environments>
    <interviewLabel>PSA - Task Time - Exclude Time from Utilization {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSA - Task Time - Exclude Time from Utilization</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Timecards</name>
        <label>Update Timecards</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>pse__Exclude_From_Utilization__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.pse__Timecard__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND ( 
                ISPICKVAL({!$Record.pse__Project_Task__r.Task_Type__c}, &apos;Education&apos;),
                {!$Record.pse__Project_Task__r.Exclude_from_Utilization__c}
        )</filterFormula>
        <object>pse__Task_Time__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Update_Timecards</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
