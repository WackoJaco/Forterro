    <decisions>
        <name>Project_Billing_Type</name>
        <label>Project Billing Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Fixed_Price</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed Price</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Milestones</targetReference>
            </connector>
            <label>Fixed Price</label>
        </rules>
        <rules>
            <name>Time_Material</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Time and Materials</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Timecards</targetReference>
            </connector>
            <label>Time &amp; Material</label>
        </rules>
        <rules>
            <name>Mixed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mixed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Mixed_Timecard_Splits</targetReference>
            </connector>
            <label>Mixed</label>
        </rules>
        <rules>
            <name>Subscription</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Billing_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Subscription</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Subscription_Misc_Adjustments</targetReference>
            </connector>
            <label>Subscription</label>
        </rules>
    </decisions>
    <description>Depending on the Project Billing Type, go through all records that would be eligible or pending Revenue Recogintion. This will then populate in the Total Revenue to Date field on a Project, which will be used to calculate Revenue Margin and Revenue Margin % on a Project record</description>
    <environments>Default</environments>
    <formulas>
        <name>FPTotalRevenueCalculation</name>
        <dataType>Currency</dataType>
        <expression>{!Collect_FP_Misc_Adjustmet} + {!Collect_Milestone_Complete_amount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MixedBillableAmountCalculation</name>
        <dataType>Currency</dataType>
        <expression>{!Collected_Mixed_Milestones} + {!Collected_Mixed_Timecards} + {!Collected_Mixed_Misc_Asjustments}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SubscriptionTotalRevenueCalculation</name>
        <dataType>Currency</dataType>
        <expression>{!Collected_Sub_Milestone} + {!Collected_Subscription_Misc_Adjustments}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TMTotalRevenueCalculation</name>
        <dataType>Currency</dataType>
        <expression>{!Collect_Billable_Amounts} + {!Collect_T_M_Misc_Adjustment}</expression>
        <scale>2</scale>
    </formulas>
