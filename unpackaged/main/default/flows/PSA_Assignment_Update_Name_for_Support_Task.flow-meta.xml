        <expression>LEFT({!$Record.pse__Project__r.pse__Account__r.Name}&amp;&apos;-&apos;&amp;{!Get_Related_Task.pse__Project_Task__r.Name},80)</expression>
    </formulas>
    <formulas>
        <name>txtOngoingAssignmentName</name>
        <dataType>String</dataType>
        <expression>{!$Record.pse__Project__r.Name}&amp;&apos;-&apos;&amp;{!Get_Related_Task.pse__Project_Task__r.Name}</expression>
    </formulas>
