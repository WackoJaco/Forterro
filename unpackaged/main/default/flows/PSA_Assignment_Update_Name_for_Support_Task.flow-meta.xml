            </connector>
            <label>Ongoing Project Task</label>
        </rules>
    </decisions>
    <description>Updates Assignment name based on Support Task or Ongoing Project.</description>
    <environments>Default</environments>
    <formulas>
        <name>formAssignmentName</name>
