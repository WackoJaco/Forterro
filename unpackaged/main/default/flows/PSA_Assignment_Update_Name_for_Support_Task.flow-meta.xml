                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Name</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>Ongoing_Project_Task</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Task.pse__Project_Task__r.pse__Project__r.Project_Sub_Types__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IBS - Ongoing Work</stringValue>
