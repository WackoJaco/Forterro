    <description>Allows for summing of Estimated, Actual and Remaining hours across all Project Task records associated to a Project, and will deliver the values to target fields on the Parent Project record.

Additionally Streamlined for Volume</description>
    <environments>Default</environments>
    <interviewLabel>Certinia: Project Task - Delete (Hours Rollups to Project) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Certinia: Project Task - Delete (Hours Rollups to Project)</label>
    <loops>
        <name>Loop_Filtered_Project_Tasks</name>
        <label>Loop Filtered Project Tasks</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <collectionReference>Remove_Triggering_Record_from_Level_0_Collection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collate_Total_Hours_Filtered</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Total_Hours_On_Project</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loop through all Project Task Records.</description>
        <name>Loop_Sibling_Project_Tasks</name>
        <label>Loop Sibling Project Tasks</label>
        <locationX>402</locationX>
        <locationY>503</locationY>
        <collectionReference>Retrieve_Sibling_Project_Tasks_Child_Only</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
