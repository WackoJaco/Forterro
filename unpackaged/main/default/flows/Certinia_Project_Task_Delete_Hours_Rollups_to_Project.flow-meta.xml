    <recordLookups>
        <description>Find all other Project Task Records that are not summary tasks which belong within the parent Project Record.</description>
        <name>Retrieve_Sibling_Project_Tasks_Child_Only</name>
        <label>Retrieve ALL Level 0 Tasks</label>
        <locationX>226</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Triggering_Record_Summary_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pse__Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pse__Project__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>pse__Hierarchy_Depth__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>pse__Project_Task__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>pse__Estimated_Hours__c</queriedFields>
        <queriedFields>pse__Actual_Hours__c</queriedFields>
        <queriedFields>pse__Hours_Remaining__c</queriedFields>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Will update the Total Hours (From Tasks) fields on the Project Record with the value stored in the flow variables.</description>
        <name>Update_Total_Hours_On_Project</name>
        <label>Update Total Hours On Project</label>
        <locationX>226</locationX>
        <locationY>995</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pse__Project__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CPS_Total_Actual_Hours_From_Tasks__c</field>
            <value>
                <elementReference>TasksTotalActualHours</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CPS_Total_Estimated_Hours_From_Tasks__c</field>
            <value>
                <elementReference>TasksTotalEstimatedHours</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CPS_Total_Remaining_Hours_From_Tasks__c</field>
            <value>
                <elementReference>TasksTotalRemainingHours</elementReference>
            </value>
        </inputAssignments>
        <object>pse__Proj__c</object>
    </recordUpdates>
    <start>
        <locationX>100</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Retrieve_Sibling_Project_Tasks_Child_Only</targetReference>
        </connector>
        <filterFormula>AND(
    OR(
        {!$Record.pse__Estimated_Hours__c} != 0,
        {!$Record.pse__Actual_Hours__c} != 0,
        {!$Record.pse__Hours_Remaining__c} != 0
    ),
{!$Record.pse__Hierarchy_Depth__c} = 0
)</filterFormula>
        <object>pse__Project_Task__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
